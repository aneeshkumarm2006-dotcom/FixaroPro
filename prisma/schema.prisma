enum Roles {
  OWNER
  ADMIN
  OPS_MANAGER
  FIELD_LEAD
  EMPLOYEE
  CLIENT
}

enum ProductCategory {
  LIQUID_SPRAY
  MOP_LIQUID
  DISPOSABLE
  // Durable handyman tools. The ONLY category equipment readiness compares the
  // per-service tool checklist against (SOP §8/§11.1) — see
  // src/lib/equipment-readiness.ts. Consumables must never qualify: "Bucket" and
  // "Gloves" are cleaning supplies that happen to share a noun with the tool
  // checklist, and matching them would mark every handyman as missing a tool
  // they were never issued.
  TOOL
  OTHER
}

enum NotificationRecipient {
  ADMIN
  CUSTOMER
  PROVIDER
}

enum NotificationChannel {
  EMAIL
  SMS
  APP_PUSH
}

// Catalog of every notification the system can emit, with per-recipient,
// per-channel enabled flag. Seeded from the Notification Catalog spec; admin
// can toggle any row from Settings → Notifications.
model NotificationSetting {
  id         String                @id @default(cuid())
  recipient  NotificationRecipient
  category   String
  key        String
  label      String
  trigger    String
  channel    NotificationChannel
  enabled    Boolean               @default(false)
  isProposed Boolean               @default(false)
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([recipient, key, channel])
  @@index([recipient])
  @@index([category])
}

