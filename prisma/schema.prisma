/**
 * One-time token a customer uses on the public /add-card/[token] page
 * to save their card on file without needing a portal login. The link
 * is emailed by admin via the job detail "Send Add card link" action.
 */
model ClientCardSetupToken {
  id        String    @id @default(cuid())
  clientId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  jobId     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
  @@index([expiresAt])
}

model GiftCard {
  id                    String         @id @default(cuid())
  code                  String         @unique
  amount                Float
  status                GiftCardStatus @default(PENDING_PAYMENT)
  // Buyer
  purchaserName         String
  purchaserEmail        String
  purchaserClientId     String?
  // Recipient (buyer can also be the recipient = same as purchaser fields)
  recipientName         String
  recipientEmail        String
  personalMessage       String?
  // Optional scheduled delivery; if null we send right after purchase.
  scheduledDeliveryDate DateTime?
  deliveredAt           DateTime?
  // Cover photo key (e.g. "birthday", "holiday", "thankyou", "default").
  // The actual image URL lives in src/lib/gift-cards/covers.ts.
  coverKey              String         @default("default")
  // Stripe purchase PaymentIntent.
  stripePaymentIntentId String?
  // Redemption tracking
  redeemedAt            DateTime?
  redeemedByClientId    String?
  // Audit
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([status])
  @@index([recipientEmail])
  @@index([scheduledDeliveryDate])
  @@index([createdAt])
}

model JobAssignmentInvite {
  id            String            @id @default(cuid())
  jobId         String
  cleanerId     String
  decision      JobInviteDecision @default(PENDING)
  sentAt        DateTime          @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime
  declineReason String?
  // If true, this invite was created as part of a last-minute reposting
  // and the cleaner who accepts earns the configured bonus.
  isLastMinute  Boolean           @default(false)
  bonusUsd      Float             @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner       User              @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([jobId, cleanerId])
  @@index([cleanerId, decision])
  @@index([expiresAt])
}

model QuoteRequest {
  id                 String             @id @default(cuid())
  name               String
  email              String
  phone              String?
  address            String?
  // Catalog value (e.g. "AC_INSTALLATION"), same source as Book Now (SOP v4.2 §4).
  // Legacy rows may still hold the old free-text label; display falls back to raw.
  serviceType        String?
  bedCount           Int?
  bathCount          Int?
  squareFootage      Int?
  preferredDate      DateTime?
  message            String?
  // Service-specific intake (SOP v4.2 §4) — mirrors the Job columns. Only the
  // fields for the selected service are set. Photos the customer attached are
  // stored as Cloudinary secure URLs (no Job/JobPhoto exists until conversion).
  paintRepairArea    String?
  paintRepairSurface String?
  acType             String?
  acLocation         String?
  acMountType        String?
  clientHasAcUnit    Boolean?
  photoUrls          String[]           @default([])
  status             QuoteRequestStatus @default(NEW)
  source             String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum JobApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  HIRED
  REJECTED
  ARCHIVED
}

// Public careers intake. Modeled on QuoteRequest. Resume is uploaded to
// Cloudinary as a raw resource and the secure URL stored here.
model JobApplication {
  id          String               @id @default(cuid())
  name        String
  email       String
  phone       String?
  position    String?
  experience  String?
  coverLetter String?
  resumeUrl   String?
  status      JobApplicationStatus @default(NEW)
  source      String?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ServiceArea {
  id        String   @id @default(cuid())
  prefix    String   @unique
  zoneName  String
  isActive  Boolean  @default(true)
  travelFee Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Lead {
  id             String     @id @default(cuid())
  email          String
  name           String?
  phone          String?
  postalCode     String?
  dropOffStep    Int?
  serviceType    String?
  bedCount       Int?
  bathCount      Int?
  halfBathCount  Int?
  squareFootage  Int?
  preferredDate  DateTime?
  isFlexible     Boolean    @default(false)
  preferredSlot  String?
  payload        Json?
  status         LeadStatus @default(NEW)
  source         String?
  convertedJobId String?
  convertedAt    DateTime?
  lastActivityAt DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  convertedJob   Job?       @relation(fields: [convertedJobId], references: [id], onDelete: SetNull)
  contact        Contact?

  @@index([email])
  @@index([status])
  @@index([lastActivityAt])
}

// CRM contact (ported from Cleano). Unifies leads + clients + applicants into a
// single pipeline record with lifecycle stage, activities, and a flexible props
// bag. Optionally linked 1:1 to a Client and/or Lead.
model Contact {
  id                 String            @id @default(cuid())
  name               String
  email              String?
  phone              String?
  address            String?
  lifecycle          LifecycleStage    @default(NEW_LEAD)
  source             String?
  sourceDetail       String?
  latestSource       String?
  campaign           String?
  ownerId            String?
  leadScore          Int?
  nextStep           String?
  nextStepDue        DateTime?
  tags               String[]          @default([])
  props              Json?
  ratingAvg          Float?
  ratingCount        Int               @default(0)
  lifetimeValue      Float             @default(0)
  bookingsCount      Int               @default(0)
  duplicateDismissed Boolean           @default(false)
  archivedAt         DateTime?
  clientId           String?           @unique
  leadId             String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastActivityAt     DateTime          @default(now())
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities         ContactActivity[]

  @@index([lifecycle])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@index([email])
  @@index([phone])
}

model ContactActivity {
  id        String              @id @default(cuid())
  contactId String
  type      ContactActivityType @default(NOTE)
  title     String
  body      String?
  actor     String?
  createdAt DateTime            @default(now())
  contact   Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}

enum ContactActivityType {
  NOTE
  EMAIL
  SMS
  CALL
  BOOKING
  RATING
  CANCEL
  LIFECYCLE
  CREATE
}

enum LifecycleStage {
  NEW_LEAD
  QUALIFIED
  BOOKED
  ACTIVE
  RETURNING
  PAST
  LOST
  APPLICANT
  CLEANER
  DNC
}

// Admin-defined custom properties (ported from Cleano). Drives the flexible
// property cards on contacts/companies/bookings (stored in Contact.props).
model PropertyDefinition {
  id           String    @id @default(cuid())
  objectType   String // contact | company | booking
  groupName    String
  label        String
  internalName String
  fieldType    String // text|textarea|number|email|phone|date|dropdown|multi|checkbox|user
  options      String[]  @default([])
  isSystem     Boolean   @default(false)
  isRequired   Boolean   @default(false)
  isUnique     Boolean   @default(false)
  visibility   String    @default("everyone") // everyone | admin
  sortOrder    Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([objectType, internalName])
  @@index([objectType])
}

// Ad spend imports for cost-per-acquisition reporting (ported from Cleano).
model AdSpendImport {
  id           String   @id @default(cuid())
  channel      String // normalized channel id: google | instagram | facebook | …
  date         DateTime
  amount       Float
  source       String? // "Manual" | "CSV · file.csv"
  importedById String?
  createdAt    DateTime @default(now())

  @@index([channel])
  @@index([date])
}

model Waitlist {
  id             String         @id @default(cuid())
  preferredDate  DateTime
  email          String
  name           String?
  phone          String?
  clientId       String?
  serviceType    String?
  bedCount       Int?
  bathCount      Int?
  notes          String?
  status         WaitlistStatus @default(WAITING)
  notifiedAt     DateTime?
  convertedJobId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  convertedJob   Job?           @relation(fields: [convertedJobId], references: [id], onDelete: SetNull)

  @@index([preferredDate])
  @@index([status])
  @@index([email])
}

model EmailLog {
  id              String      @id @default(cuid())
  kind            EmailKind
  recipient       String
  subject         String?
  status          EmailStatus @default(PENDING)
  jobId           String?
  leadId          String?
  waitlistId      String?
  providerId      String?
  error           String?
  sentAt          DateTime?
  notificationKey String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  job             Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([status])
  @@index([jobId])
  @@index([recipient])
}

model JobRatingToken {
  id              String    @id @default(cuid())
  jobId           String
  token           String    @unique
  cleanerId       String?
  // Customer linkage — lets the portal popup find the right token without a
  // job scan, and ties the rating record back to the client.
  customerId      String?
  // Captured star value (raw 1–5). Null until the customer actually rates.
  ratingStars     Int?
  // "Rather not answer" — the customer was prompted but declined. We stamp
  // this (and usedAt) and write NO EmployeeRating row, so a skip never
  // poisons the cleaner's average or pay multiplier.
  ratherNotAnswer Boolean   @default(false)
  // Idempotency stamps for the two prompt channels: email send + popup show.
  emailSentAt     DateTime?
  popupShownAt    DateTime?
  usedAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([token])
  @@index([customerId])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("FIXED") // FIXED | PERCENT
  discountValue Float
  maxUses       Int?
  usesCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
}

enum SaveOfferStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  REPLIED
  REACTIVATED
  EXPIRED
}

// One row per full-recurring cancellation. Drives the retention "save offer"
// email + the retention KPI dashboard. Lifecycle stamps track the funnel:
// sent → opened (pixel) → clicked (redirect) → replied (admin) → reactivated.
model RecurringCancellation {
  id            String           @id @default(cuid())
  clientId      String
  frequency     ServiceFrequency
  reason        String?
  cancelledAt   DateTime         @default(now())
  emailSentAt   DateTime?
  // Save offer snapshot (mirrors PromoCode discountType/value + the code minted).
  offerType     String? // FIXED | PERCENT
  offerValue    Float?
  offerCode     String?
  offerStatus   SaveOfferStatus  @default(PENDING)
  openedAt      DateTime?
  clickedAt     DateTime?
  repliedAt     DateTime?
  reactivatedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([offerStatus])
  @@index([cancelledAt])
}

enum StrikeReason {
  LATE_ARRIVAL
  LATE_CANCEL
  REFUND_ISSUED
  LOW_RATING
  MANUAL
}

enum StrikeStatus {
  ACTIVE
  EXCUSED
  REMOVED
}

// Three-strike accountability. The rolling 30-day active count is computed on
// read (no cron) — strikes outside the window simply don't count. EXCUSED /
// REMOVED strikes are kept for the audit trail but never count toward the
// threshold.
model CleanerStrike {
  id        String       @id @default(cuid())
  cleanerId String
  jobId     String?
  reason    StrikeReason
  status    StrikeStatus @default(ACTIVE)
  note      String?
  // Admin who issued / excused / removed the strike (null for auto-triggers).
  actionBy  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  cleaner   User         @relation("CleanerStrikes", fields: [cleanerId], references: [id], onDelete: Cascade)
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([cleanerId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

// Who a team announcement is targeted at. Visibility is enforced server-side
// (see announcements/page.tsx): ADMINS-only posts never reach providers.
enum AnnouncementAudience {
  ALL
  PROVIDERS
  ADMINS
}

// Internal "Team hub" announcements. authorId / userId reference User.id but are
// intentionally kept as plain columns (no DB FK to User) so this feature is a
// purely additive set of new tables — it touches no existing model or column.
model Announcement {
  id          String                 @id @default(cuid())
  title       String
  body        String
  authorId    String
  authorLabel String
  audience    AnnouncementAudience   @default(ALL)
  pinned      Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  reactions   AnnouncementReaction[]
  acks        AnnouncementAck[]

  @@index([pinned, createdAt])
  @@index([authorId])
  @@index([audience])
}

// One row per (announcement, user, emoji). The unique constraint makes toggling
// idempotent — a repeat reaction is a no-op / delete, never a duplicate.
model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
  @@index([userId])
}

// One row per (announcement, user). Acknowledging twice is idempotent.
model AnnouncementAck {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
}
