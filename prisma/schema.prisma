generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                       @id @default(cuid())
  name                         String
  email                        String                       @unique
  image                        String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  phone                        String?
  // Least-privilege default. Staff accounts are created by an admin via
  // createEmployee (which sets `role` explicitly); the only other path that
  // reaches better-auth's public signUp endpoint is the customer portal, whose
  // accounts must be CLIENT anyway. Never default to a staff role — a public
  // signUp would otherwise mint an EMPLOYEE.
  role                         Roles                        @default(CLIENT)
  emailVerified                Boolean                      @default(false)
  payMultiplier                Float                        @default(1.0)
  multiplierLastRecalculatedAt DateTime?
  lastSeenAt                   DateTime?
  accounts                     Account[]
  assignedProducts             EmployeeProduct[]
  inventoryRequests            InventoryRequest[]
  jobs                         Job[]                        @relation("EmployeeJobs")
  sessions                     Session[]
  cleaningJobs                 Job[]                        @relation("JobCleaners")
  jobInvites                   JobAssignmentInvite[]
  jobLogs                      JobLog[]                     @relation("UserJobLogs")
  payouts                      Payout[]
  approvedPeriods              PayPeriod[]                  @relation("PayPeriodApprover")
  availabilities               EmployeeAvailability[]
  photos                       JobPhoto[]
  checklists                   JobChecklist[]
  signatures                   DocumentSignature[]
  trainingProgress             TrainingProgress[]
  ratings                      EmployeeRating[]
  withdrawals                  Withdrawal[]
  checkouts                    InventoryCheckout[]
  chatConversation             ChatConversation?            @relation("EmployeeChatConversation")
  sentChatMessages             ChatMessage[]                @relation("ChatMessageSender")
  employeeComplaints           Complaint[]                  @relation("EmployeeComplaints")
  resolvedComplaints           Complaint[]                  @relation("ResolvedComplaints")
  receivedAlerts               Alert[]                      @relation("RecipientAlerts")
  strikes                      CleanerStrike[]              @relation("CleanerStrikes")
  paintingBids                 PaintingBid[]                @relation("ProviderPaintingBids")
  serviceEligibilities         EmployeeServiceEligibility[] @relation("EmployeeEligibilities")
  serviceEquipmentEdits        ServiceEquipment[]           @relation("ServiceEquipmentUpdatedBy")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accessToken  String?
  accountId    String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  idToken      String?
  password     String?
  providerId   String
  refreshToken String?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  token     String   @unique
  updatedAt DateTime @updatedAt
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id                String                   @id @default(cuid())
  name              String
  description       String?
  unit              String
  costPerUnit       Float
  stockLevel        Float                    @default(0)
  minStock          Float                    @default(0)
  category          ProductCategory          @default(OTHER)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  employeeProducts  EmployeeProduct[]
  inventoryRequests InventoryRequest[]
  jobUsage          JobProductUsage[]
  kitItems          KitTemplateItem[]
  inventoryRule     InventoryRule?
  supplierPrices    SupplierPrice[]
  locationStock     InventoryLocationStock[]
  checkoutItems     InventoryCheckoutItem[]
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  category  String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ── Exportable config layer (SOP §3, stage 8) ──────────────────────────────
// SOP §3 phase 1 requires every setting and workflow in this document to be
// "represented in the database/config layer and exportable/importable by
// environment". The service catalog, its materials/equipment pricing and the
// painting cost baselines used to ship as TypeScript constants, so adding or
// retiring a service — or repricing one — needed a deploy.
//
// The TS constants (src/app/(book)/book/types.ts, src/lib/painting.ts) are
// retained as SEED DEFAULTS: src/lib/config/service-config.ts seeds these tables
// from them on first admin visit and falls back to them while the tables are
// empty, so an unseeded environment behaves exactly as it did before.
//
// Policy values (fees, windows, rates) live in AppSetting under the `policy` /
// `pricing` categories, declared once in src/lib/config/policy-registry.ts with
// a label, default, help text and validation rule (SOP §2.3).

/// How a service's LABOUR is priced (decision D0.7). Orthogonal to the
/// materials/equipment axis below — the two compose freely.
enum ServicePricingModel {
  /// Billable clocked hours × labour rate (package-aware). The default.
  HOURLY
  /// A fixed price: `fixedPrice`, optionally × units (Silicone sealing / room).
  FIXED
  /// Bid- or quote-derived (Painting: accepted bid × surplus rate).
  QUOTE
}

/// What the service's materials/equipment amount MEANS (SOP §5). Applies only
/// when the customer checks the all-or-nothing Fixaro-materials box.
enum MaterialsChargeType {
  /// Refundable deposit. Captured upfront; "D" review indicator; apply/refund.
  DEPOSIT
  /// Flat line item billed on the final invoice. Nothing captured upfront.
  COST
  /// Flat line item captured upfront but NOT a deposit — painting's $119.
  CHARGE
}

/// One bookable service. Seeded from SERVICE_CATALOG + MATERIALS_PRICING.
model ServiceCatalogItem {
  id       String @id @default(cuid())
  /// Matches Job.jobType / ServiceEquipment.serviceType / eligibility rows.
  value    String @unique
  label    String
  category String

  pricing   ServicePricingModel @default(HOURLY)
  priceNote String?

  /// D0.2: ops can retire a service without a deploy. Inactive services stay
  /// bookable-in-history and keep rendering their label everywhere, but are
  /// hidden from the booking page, the quote form and new-job targeting.
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  /// pricing = FIXED only. `fixedPricePerUnit` multiplies by the booked hours
  /// field, which the booking UI reuses as a unit count (Silicone: $209/room).
  fixedPrice        Float?
  fixedPricePerUnit Boolean @default(false)

  /// Materials/equipment (SOP §5). NULL = this service has no materials amount
  /// at all (AC installation), which is different from an amount of 0.
  materialsAmount Float?
  materialsType   MaterialsChargeType?
  /// Customer-facing qualifier appended to the materials line, e.g. painting's
  /// "paint not included" (D0.3). Copy ops should own, not a deploy.
  materialsNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

/// Internal painting cost baseline per scope (SOP §7). PRE-surplus: the
/// customer-facing range is baseline × the `painting.surplusRate` policy value.
model PaintingBaseline {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  baselineMin Float
  baselineMax Float
  note        String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-editable equipment/products checklist per service type (SOP §4/§8:
// "Checklist templates must be admin-editable by service and visible to
// handyman/admin where appropriate").
//
// A row here OVERRIDES the seeded defaults in src/lib/equipment.ts. Absence of a
// row means "use the default" — so this table starts empty and only holds the
// services an admin has actually customised.
model ServiceEquipment {
  serviceType String   @id // matches SERVICE_CATALOG value / Job.jobType
  items       String[]
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("ServiceEquipmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model KitTemplate {
  id                String             @id @default(cuid())
  name              String
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             KitTemplateItem[]
  inventoryRequests InventoryRequest[]
}

model KitTemplateItem {
  id            String      @id @default(cuid())
  kitTemplateId String
  productId     String
  quantity      Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  kitTemplate   KitTemplate @relation(fields: [kitTemplateId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kitTemplateId, productId])
  @@index([kitTemplateId])
  @@index([productId])
}

model InventoryRule {
  id              String   @id @default(cuid())
  productId       String   @unique
  usagePerJob     Float    @default(0)
  refillThreshold Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  prices    SupplierPrice[]
}

model SupplierPrice {
  id         String   @id @default(cuid())
  supplierId String
  productId  String
  price      Float
  unit       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model Client {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String?
  secondaryEmail         String?
  phone                  String?
  secondaryPhone         String?
  company                String?
  address                String?
  aptNumber              String?
  city                   String?
  state                  String?
  zip                    String?
  notes                  String?
  discountPercent        Float                   @default(0)
  clientType             ClientType              @default(RESIDENTIAL)
  serviceFrequency       ServiceFrequency?
  isActive               Boolean                 @default(true)
  stripeCustomerId       String?                 @unique
  defaultPaymentMethodId String?
  referralCode           String?                 @unique
  referralCredit         Float                   @default(0)
  // Account credit from redeemed gift cards. Auto-applies at chargeJob time
  // (drains down to zero before the card-on-file is charged).
  giftCardBalance        Float                   @default(0)
  // No-show tracking: incremented on each admin-confirmed no-show. The
  // automatic 1-star is captured here (count + timestamp) rather than as
  // a Client-side rating row, because the existing review system only
  // models cleaner ratings.
  noShowCount            Int                     @default(0)
  lastNoShowAt           DateTime?
  referredByClientId     String?
  userId                 String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  jobs                   Job[]
  invoices               Invoice[]
  complaints             Complaint[]
  waitlistEntries        Waitlist[]
  referredBy             Client?                 @relation("ClientReferrals", fields: [referredByClientId], references: [id], onDelete: SetNull)
  referrals              Client[]                @relation("ClientReferrals")
  recurringCancellations RecurringCancellation[]
  addresses              ClientAddress[]
  contact                Contact?

  @@index([clientType])
  @@index([isActive])
  @@index([referredByClientId])
}

// Multiple saved addresses per client (e.g. repeat customers with several
// properties). The single `Client.address` remains the primary/legacy field;
// these are additional labeled addresses.
model ClientAddress {
  id        String   @id @default(cuid())
  clientId  String
  label     String   @default("Home")
  address   String
  aptNumber String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
}

enum ServiceFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

model Job {
  id                             String                @id @default(cuid())
  jobNumber                      Int                   @unique @default(autoincrement())
  employeeId                     String?
  clientName                     String
  clientId                       String?
  location                       String?
  apartmentNumber                String?
  description                    String?
  jobType                        String?
  jobDate                        DateTime?
  startTime                      DateTime
  endTime                        DateTime?
  clockInTime                    DateTime?
  clockOutTime                   DateTime?
  status                         JobStatus             @default(CREATED)
  price                          Float?
  employeePay                    Float?
  totalTip                       Float?
  parking                        Float?
  paymentReceived                Boolean               @default(false)
  invoiceSent                    Boolean               @default(false)
  notes                          String?
  // Provider-facing job completion (SOP §8 "Job completion tools: notes, photos,
  // status updates, completed marker"). `notes` above is the CUSTOMER's brief;
  // `completionNotes` is the handyman's write-up of what they actually did,
  // captured at clock-out (which is what completes a job) or via the separate
  // mark-complete step for jobs with no clock record. `completedAt`/`completedById`
  // are the completed marker — who closed it and when, which is not recoverable
  // from clockOutTime once an admin corrects the clock. The status transition
  // itself is written to AuditLog.
  completionNotes                String?
  completedAt                    DateTime?
  completedById                  String?
  paymentType                    PaymentType?
  discountAmount                 Float?
  bedCount                       Int?
  bathCount                      Int?
  payRateMultiplier              Float?                @default(1.0)
  isFlexible                     Boolean               @default(false)
  requiredCleaners               Int                   @default(1)
  subtotalAmount                 Float                 @default(0)
  gstAmount                      Float                 @default(0)
  qstAmount                      Float                 @default(0)
  tipAmount                      Float                 @default(0)
  totalAmount                    Float                 @default(0)
  // Hourly billing (SOP §10). At clock-out / clock-correction the stored charge
  // fields above (price, subtotalAmount, gstAmount, qstAmount) are overwritten
  // for hourly jobs with the clocked amount so every consumer (receipts,
  // invoices, portal, analytics, refunds) reads one authoritative figure.
  // `bookedSubtotalAmount` + `basePriceAmount` are the IMMUTABLE booked baseline
  // (subtotal, and the labour component within it) captured at booking, so
  // computeChargeAmount() can recompute the swap idempotently no matter how many
  // times the clock is corrected. `billableHours` / `computedLabourAmount` /
  // `computedTotal` cache the recomputed values (null on fixed & quote jobs,
  // which keep their booked price).
  basePriceAmount                Float?
  bookedSubtotalAmount           Float?
  billableHours                  Float?
  computedLabourAmount           Float?
  computedTotal                  Float?
  stripeSetupIntentId            String?
  stripePaymentIntentId          String?
  depositPaymentIntentId         String?
  depositPaid                    Boolean               @default(false)
  depositPaidAt                  DateTime?
  // Materials/equipment decision (SOP §4/§5). All-or-nothing: when true the
  // customer asked Fixaro to provide everything and a per-service amount applies.
  // `materialsType` is "deposit" (refundable / applied to final bill, tracked
  // separately) or "cost" (flat line item). Applied/refunded amounts are filled
  // in during admin charge review (see SOP §10).
  customerRequestsMaterials      Boolean               @default(false)
  materialsAmount                Float?
  materialsType                  String?
  materialsAppliedAmount         Float?
  materialsRefundedAt            DateTime?
  // Painting bid workflow (SOP §6/§7). Only set on PAINTING jobs.
  //   QUOTED → BIDDING → OFFER_SENT → ACCEPTED / REJECTED / CANCELLED
  // Immediate customer range = internal baseline × 1.35 surplus (§7).
  // Final amount = accepted (lowest valid) bid × surplus. Provider override is
  // independent of price: swapping the provider keeps the client's agreed price
  // unless an admin explicitly re-prices (see SOP §6 / tracker D3).
  paintingStatus                 PaintingStatus?
  paintingScope                  String?
  quoteRangeMin                  Float?
  quoteRangeMax                  Float?
  acceptedBidId                  String?
  acceptedBidAmount              Float?
  paintingSurplusRate            Float?                @default(1.35)
  paintingFinalAmount            Float?
  offerSentAt                    DateTime?
  offerRespondedAt               DateTime?
  offerResponse                  String?
  offerLastReminderAt            DateTime?
  followUpFlaggedAt              DateTime?
  providerOverrideReason         String?
  providerOverrideAt             DateTime?
  providerOverrideBy             String?
  // Service-specific intake (SOP v4.2 §4). Photos reuse the JobPhoto relation and
  // free-text detail goes in `notes`; these capture the structured answers.
  // Small paint repair — client always supplies the paint (no paint-colour
  // procurement is collected, per v4.2).
  paintRepairArea                String?
  paintRepairSurface             String?
  // AC installation — client supplies the unit/accessories unless an admin
  // approves a separate extra.
  acType                         String?
  acLocation                     String?
  acMountType                    String?
  clientHasAcUnit                Boolean?
  paymentFailedAt                DateTime?
  paymentFailureReason           String?
  paidAt                         DateTime?
  refundedAmount                 Float                 @default(0)
  isCashJob                      Boolean               @default(false)
  appliedPromoCode               String?
  promoDiscountAmount            Float?
  cancellationRequestedAt        DateTime?
  rescheduleRequestedAt          DateTime?
  parentJobId                    String?
  bookingSource                  String?
  squareFootage                  Int?
  halfBathCount                  Int?
  // No-show + late-arrival event timestamps (admin action + clock-in watcher).
  noShowAt                       DateTime?
  lateArrivalAt                  DateTime?
  // Rating cap applied to the cleaner for this job because they were late.
  // 4 stars at +10 min; -0.5 stars per additional 5 min (see src/lib/policy.ts).
  lateArrivalRatingCap           Float?
  // After-photo consent (captured at booking). Cleaners may not upload
  // after-photos unless the customer consented OR an admin override is set.
  // Enforced server-side in uploadJobPhoto.ts.
  afterPhotoConsent              Boolean               @default(false)
  afterPhotoConsentAt            DateTime?
  afterPhotoConsentVersion       String?
  afterPhotoOverrideAt           DateTime?
  afterPhotoOverrideBy           String?
  // Late-cancellation fee charged to the saved card when the customer cancels
  // within the 24h window (see CANCELLATION_FEE_WINDOW_HOURS in policy.ts).
  // `cancellationFeeChargedAt` makes the charge idempotent.
  cancellationFeeChargedAt       DateTime?
  cancellationFeePaymentIntentId String?
  // Card hold lifecycle. `holdPaymentIntentId` is set when admin (or the
  // booking flow) places a manual-capture PI for the full job price.
  holdPaymentIntentId            String?
  holdPlacedAt                   DateTime?
  holdAmount                     Float?
  holdCapturedAt                 DateTime?
  holdReleasedAt                 DateTime?
  holdCaptureFailedAt            DateTime?
  holdCaptureFailReason          String?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  employee                       User?                 @relation("EmployeeJobs", fields: [employeeId], references: [id], onDelete: SetNull)
  client                         Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parentJob                      Job?                  @relation("JobRecurrence", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs                      Job[]                 @relation("JobRecurrence")
  productUsage                   JobProductUsage[]
  cleaners                       User[]                @relation("JobCleaners")
  assignmentInvites              JobAssignmentInvite[]
  logs                           JobLog[]
  addOns                         JobAddOn[]
  transactions                   Transaction[]
  invoices                       Invoice[]
  photos                         JobPhoto[]
  checklists                     JobChecklist[]
  ratings                        EmployeeRating[]
  complaints                     Complaint[]
  emailLogs                      EmailLog[]
  ratingTokens                   JobRatingToken[]
  strikes                        CleanerStrike[]
  convertedFromLeads             Lead[]
  convertedFromWaitlist          Waitlist[]
  paintingBids                   PaintingBid[]

  @@index([jobDate])
  @@index([clientName])
  @@index([clientId])
  @@index([status])
  @@index([parentJobId])
  @@index([isFlexible])
}

model JobAddOn {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// Painting bid workflow status on a Job (SOP §6).
enum PaintingStatus {
  QUOTED // booking created with an immediate range, bidding not yet open
  BIDDING // painting-eligible providers notified; accepting bids
  OFFER_SENT // lowest valid bid auto-accepted, 35% surplus applied, client notified
  ACCEPTED // client accepted the final amount
  REJECTED // client rejected → booking cancelled, $119 materials/equipment charge refunded
  CANCELLED // ops cancelled (e.g. no phone answer < 24h before job)
}

// A provider's bid on a painting job (SOP §6). One active bid per provider per
// job; the lowest valid bid is auto-accepted by the software.
model PaintingBid {
  id             String    @id @default(cuid())
  jobId          String
  bidderId       String
  amount         Float
  note           String?
  isValid        Boolean   @default(true)
  isWinning      Boolean   @default(false)
  autoAcceptedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bidder         User      @relation("ProviderPaintingBids", fields: [bidderId], references: [id], onDelete: Cascade)

  @@unique([jobId, bidderId])
  @@index([jobId])
  @@index([bidderId])
}

// Admin-controlled provider service eligibility (SOP §8). A handyman may only
// claim/bid on services they are approved for; the matrix is read-only to the
// provider and edited by admins. Ineligible jobs are filtered out server-side.
model EmployeeServiceEligibility {
  id          String   @id @default(cuid())
  employeeId  String
  serviceType String // matches Job.jobType / SERVICE_CATALOG value
  isActive    Boolean  @default(true)
  approvedBy  String? // admin user id who last changed it
  approvedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    User     @relation("EmployeeEligibilities", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceType])
  @@index([employeeId])
  @@index([serviceType])
}

// Stripe webhook idempotency (ported from Cleano). Claiming the event id before
// processing makes duplicate deliveries (Stripe retries the same id) a no-op.
model WebhookEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Generic high-impact audit trail (SOP §9). Records who changed what, when, and
// why for eligibility, deposits, refunds, charges, overrides, etc. JobLog stays
// the job-scoped activity feed; this is the cross-entity admin audit log.
model AuditLog {
  id          String   @id @default(cuid())
  entityType  String // "EmployeeEligibility" | "Job" | "Deposit" | ...
  entityId    String
  action      String // "ELIGIBILITY_GRANTED" | "ELIGIBILITY_REVOKED" | ...
  field       String?
  oldValue    String?
  newValue    String?
  reason      String?
  actorId     String?
  actorEmail  String?
  description String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// System-wide activity/event log (ported from Cleano). Broader than AuditLog:
// records email/SMS/payment/webhook/cron/auth events with status + provider ids
// for an ops-facing timeline (the /logs view). Written via logActivity().
model ActivityLog {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  category   ActivityCategory
  action     String
  status     ActivityStatus   @default(SUCCESS)
  actorId    String? // user who triggered it (null = system/anonymous)
  actorLabel String? // denormalized name/email for display
  targetType String? // e.g. "job", "client", "giftCard"
  targetId   String?
  message    String?
  error      String?
  amount     Float?
  providerId String? // Stripe PI / Twilio SID / Resend id
  metadata   Json?

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

enum ActivityCategory {
  EMAIL
  SMS
  PAYMENT
  REFUND
  DEPOSIT
  WEBHOOK
  AUTH
  BOOKING
  ADMIN
  CRON
  SYSTEM
}

enum ActivityStatus {
  SUCCESS
  FAILED
  PENDING
  SKIPPED
}

model PricingRule {
  id        String   @id @default(cuid())
  bedCount  Int
  bathCount Int
  basePrice Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bedCount, bathCount])
}

model JobProductUsage {
  id              String   @id @default(cuid())
  jobId           String
  productId       String
  quantity        Float
  inventoryBefore Float?
  inventoryAfter  Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([jobId, productId])
}

model JobLog {
  id          String       @id @default(cuid())
  jobId       String
  userId      String?
  action      JobLogAction
  field       String?
  oldValue    String?
  newValue    String?
  description String
  createdAt   DateTime     @default(now())
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User?        @relation("UserJobLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([createdAt])
  @@index([userId])
}

model InventoryRequest {
  id          String        @id @default(cuid())
  employeeId  String
  productId   String?
  kitId       String?
  quantity    Float
  reason      String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employee    User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  kitTemplate KitTemplate?  @relation(fields: [kitId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([productId])
  @@index([kitId])
}

model EmployeeProduct {
  id         String   @id @default(cuid())
  employeeId String
  productId  String
  quantity   Float
  assignedAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([employeeId, productId])
  @@index([employeeId])
  @@index([productId])
}

model PayPeriod {
  id           String          @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  status       PayPeriodStatus @default(DRAFT)
  notes        String?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  approvedBy   User?           @relation("PayPeriodApprover", fields: [approvedById], references: [id], onDelete: SetNull)
