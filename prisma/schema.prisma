generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  phone             String?
  role              Roles              @default(EMPLOYEE)
  emailVerified     Boolean            @default(false)
  payMultiplier     Float              @default(1.0)
  accounts          Account[]
  assignedProducts  EmployeeProduct[]
  inventoryRequests InventoryRequest[]
  jobs              Job[]              @relation("EmployeeJobs")
  sessions          Session[]
  cleaningJobs      Job[]              @relation("JobCleaners")
  jobLogs           JobLog[]           @relation("UserJobLogs")
  payouts           Payout[]
  approvedPeriods   PayPeriod[]        @relation("PayPeriodApprover")
  ragWashes         RagWash[]
  availabilities    EmployeeAvailability[]
  photos            JobPhoto[]
  checklists        JobChecklist[]
  signatures        DocumentSignature[]
  trainingProgress  TrainingProgress[]
  ratings           EmployeeRating[]
  withdrawals       Withdrawal[]
  checkouts         InventoryCheckout[]
  chatConversation  ChatConversation?  @relation("EmployeeChatConversation")
  sentChatMessages  ChatMessage[]      @relation("ChatMessageSender")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accessToken  String?
  accountId    String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  idToken      String?
  password     String?
  providerId   String
  refreshToken String?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  token     String   @unique
  updatedAt DateTime @updatedAt
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  name             String
  description      String?
  unit             String
  costPerUnit      Float
  stockLevel       Float             @default(0)
  minStock         Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  employeeProducts  EmployeeProduct[]
  inventoryRequests InventoryRequest[]
  jobUsage          JobProductUsage[]
  kitItems          KitTemplateItem[]
  inventoryRule     InventoryRule?
  supplierPrices    SupplierPrice[]
  locationStock     InventoryLocationStock[]
  checkoutItems     InventoryCheckoutItem[]
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  category  String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model KitTemplate {
  id                String             @id @default(cuid())
  name              String
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             KitTemplateItem[]
  inventoryRequests InventoryRequest[]
}

model KitTemplateItem {
  id            String      @id @default(cuid())
  kitTemplateId String
  productId     String
  quantity      Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  kitTemplate   KitTemplate @relation(fields: [kitTemplateId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kitTemplateId, productId])
  @@index([kitTemplateId])
  @@index([productId])
}

model InventoryRule {
  id              String   @id @default(cuid())
  productId       String   @unique
  usagePerJob     Float    @default(0)
  refillThreshold Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  prices    SupplierPrice[]
}

model SupplierPrice {
  id         String   @id @default(cuid())
  supplierId String
  productId  String
  price      Float
  unit       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jobs      Job[]
  invoices  Invoice[]
}

model Job {
  id                String            @id @default(cuid())
  employeeId        String
  clientName        String
  clientId          String?
  location          String?
  description       String?
  jobType           String?
  jobDate           DateTime?
  startTime         DateTime
  endTime           DateTime?
  clockInTime       DateTime?
  clockOutTime      DateTime?
  status            JobStatus         @default(CREATED)
  price             Float?
  employeePay       Float?
  totalTip          Float?
  parking           Float?
  paymentReceived   Boolean           @default(false)
  invoiceSent       Boolean           @default(false)
  notes             String?
  paymentType       PaymentType?
  discountAmount    Float?
  bedCount          Int?
  bathCount         Int?
  payRateMultiplier Float?            @default(1.0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  employee          User              @relation("EmployeeJobs", fields: [employeeId], references: [id], onDelete: Cascade)
  client            Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  productUsage      JobProductUsage[]
  cleaners          User[]            @relation("JobCleaners")
  logs              JobLog[]
  addOns            JobAddOn[]
  transactions      Transaction[]
  invoices          Invoice[]
  photos            JobPhoto[]
  checklists        JobChecklist[]
  ratings           EmployeeRating[]

  @@index([jobDate])
  @@index([clientName])
  @@index([clientId])
  @@index([status])
}

model JobAddOn {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model PricingRule {
  id        String   @id @default(cuid())
  bedCount  Int
  bathCount Int
  basePrice Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bedCount, bathCount])
}

model JobProductUsage {
  id              String   @id @default(cuid())
  jobId           String
  productId       String
  quantity        Float
  inventoryBefore Float?
  inventoryAfter  Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([jobId, productId])
}

model JobLog {
  id          String       @id @default(cuid())
  jobId       String
  userId      String?
  action      JobLogAction
  field       String?
  oldValue    String?
  newValue    String?
  description String
  createdAt   DateTime     @default(now())
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User?        @relation("UserJobLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([createdAt])
  @@index([userId])
}

model InventoryRequest {
  id          String        @id @default(cuid())
  employeeId  String
  productId   String?
  kitId       String?
  quantity    Float
  reason      String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employee    User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  kitTemplate KitTemplate?  @relation(fields: [kitId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([productId])
  @@index([kitId])
}

model EmployeeProduct {
  id         String   @id @default(cuid())
  employeeId String
  productId  String
  quantity   Float
  assignedAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([employeeId, productId])
  @@index([employeeId])
  @@index([productId])
}

model PayPeriod {
  id           String          @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  status       PayPeriodStatus @default(DRAFT)
  notes        String?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  approvedBy   User?           @relation("PayPeriodApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  payouts      Payout[]

  @@index([startDate])
  @@index([status])
}

model Payout {
  id             String    @id @default(cuid())
  payPeriodId    String
  employeeId     String
  baseAmount     Float     @default(0)
  adjustments    Float     @default(0)
  deductions     Float     @default(0)
  reimbursements Float     @default(0)
  finalAmount    Float     @default(0)
  jobCount       Int       @default(0)
  totalHours     Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payPeriod      PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  employee       User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, employeeId])
  @@index([payPeriodId])
  @@index([employeeId])
}

model Transaction {
  id          String              @id @default(cuid())
  date        DateTime            @default(now())
  category    TransactionCategory
  amount      Float
  description String?
  notes       String?
  jobId       String?
  source      String?
  taxAmount   Float               @default(0)
  isAuto      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  job         Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
  @@index([jobId])
}

model RagWash {
  id          String   @id @default(cuid())
  employeeId  String
  washDate    DateTime @default(now())
  ragCount    Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([washDate])
}

model Budget {
  id        String              @id @default(cuid())
  category  TransactionCategory
  period    String
  amount    Float
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([category, period])
  @@index([period])
}

enum Roles {
  OWNER
  ADMIN
  EMPLOYEE
}

enum JobStatus {
  CREATED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum JobLogAction {
  CREATED
  UPDATED
  CLOCKED_IN
  CLOCKED_OUT
  STATUS_CHANGED
  PAYMENT_RECEIVED
  INVOICE_SENT
  PRODUCT_USED
  NOTE_ADDED
  CLEANER_ADDED
  CLEANER_REMOVED
}

enum PaymentType {
  CASH
  CHEQUE
  E_TRANSFER
  CREDIT_CARD
  OTHER
}

enum PayPeriodStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum TransactionCategory {
  REVENUE
  SUPPLIES
  LABOUR
  OVERHEAD
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String          @id @default(cuid())
  invoiceNumber String          @unique
  status        InvoiceStatus   @default(DRAFT)
  clientId      String
  jobId         String?
  subtotal      Float           @default(0)
  gstAmount     Float           @default(0)
  qstAmount     Float           @default(0)
  discountAmount Float          @default(0)
  totalAmount   Float           @default(0)
  notes         String?
  dueDate       DateTime?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job           Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems     InvoiceLineItem[]

  @@index([clientId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  amount      Float    @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Alert {
  id          String        @id @default(cuid())
  type        AlertType
  severity    AlertSeverity @default(WARNING)
  title       String
  message     String
  isRead      Boolean       @default(false)
  isDismissed Boolean       @default(false)
  relatedId   String?
  relatedType String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model Target {
  id          String       @id @default(cuid())
  metric      TargetMetric
  period      TargetPeriod
  periodStart DateTime
  targetValue Float
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([metric, period, periodStart])
  @@index([periodStart])
}

enum AlertType {
  LOW_INVENTORY
  CANCELLATION
  OVERDUE_PAYMENT
  GENERAL
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TargetMetric {
  REVENUE
  JOBS_COMPLETED
  NEW_CLIENTS
  PROFIT_MARGIN
  AVG_JOB_PRICE
  EMPLOYEE_RETENTION
}

enum TargetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// ── Phase E0: Employee Foundation ──

enum AvailabilityDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DocumentStatus {
  PENDING
  SIGNED
  EXPIRED
  REVOKED
}

enum ChecklistItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model EmployeeAvailability {
  id          String          @id @default(cuid())
  employeeId  String
  day         AvailabilityDay
  startTime   String
  endTime     String
  isAvailable Boolean         @default(true)
  isRecurring Boolean         @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  employee    User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, day])
  @@index([employeeId])
}

model JobPhoto {
  id         String   @id @default(cuid())
  jobId      String
  employeeId String
  url        String
  caption    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([employeeId])
}

model ChecklistTemplate {
  id          String                  @id @default(cuid())
  name        String
  jobType     String?
  addOnName   String?
  description String?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       ChecklistTemplateItem[]
  jobChecklists JobChecklist[]
}

model ChecklistTemplateItem {
  id          String            @id @default(cuid())
  templateId  String
  title       String
  description String?
  isRequired  Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model JobChecklist {
  id         String             @id @default(cuid())
  jobId      String
  employeeId String
  templateId String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  job        Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee   User               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items      JobChecklistItem[]

  @@index([jobId])
  @@index([employeeId])
}

model JobChecklistItem {
  id          String              @id @default(cuid())
  checklistId String
  title       String
  description String?
  status      ChecklistItemStatus @default(PENDING)
  isRequired  Boolean             @default(true)
  sortOrder   Int                 @default(0)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  checklist   JobChecklist        @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model Document {
  id          String              @id @default(cuid())
  title       String
  description String?
  content     String?             @db.Text
  fileUrl     String?
  version     String              @default("1.0")
  dueDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  signatures  DocumentSignature[]
}

model DocumentSignature {
  id            String         @id @default(cuid())
  documentId    String
  employeeId    String
  status        DocumentStatus @default(PENDING)
  signatureUrl  String?
  signedAt      DateTime?
  ipAddress     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee      User           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([documentId, employeeId])
  @@index([documentId])
  @@index([employeeId])
}

model TrainingModule {
  id          String             @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  duration    Int?
  isRequired  Boolean            @default(false)
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  quizzes     TrainingQuiz[]
  progress    TrainingProgress[]
}

model TrainingQuiz {
  id         String         @id @default(cuid())
  moduleId   String
  question   String
  options    Json
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  module     TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model TrainingProgress {
  id            String         @id @default(cuid())
  moduleId      String
  employeeId    String
  status        TrainingStatus @default(NOT_STARTED)
  videoProgress Float          @default(0)
  quizScore     Float?
  quizAttempts  Int            @default(0)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  module        TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  employee      User           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([moduleId, employeeId])
  @@index([moduleId])
  @@index([employeeId])
}

model EmployeeRating {
  id         String   @id @default(cuid())
  employeeId String
  jobId      String?
  rating     Float
  notes      String?
  ratedBy    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([jobId])
  @@index([createdAt])
}

model Withdrawal {
  id            String           @id @default(cuid())
  employeeId    String
  amount        Float
  status        WithdrawalStatus @default(PENDING)
  paymentMethod PaymentType?
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  employee      User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model InventoryLocation {
  id        String                  @id @default(cuid())
  name      String
  address   String?
  notes     String?
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  stock     InventoryLocationStock[]
  checkouts InventoryCheckout[]
}

model InventoryLocationStock {
  id         String            @id @default(cuid())
  locationId String
  productId  String
  quantity   Float             @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([locationId])
  @@index([productId])
}

model InventoryCheckout {
  id         String                  @id @default(cuid())
  employeeId String
  locationId String
  notes      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  employee   User                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location   InventoryLocation       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items      InventoryCheckoutItem[]

  @@index([employeeId])
  @@index([locationId])
}

model InventoryCheckoutItem {
  id         String            @id @default(cuid())
  checkoutId String
  productId  String
  quantity   Float
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  checkout   InventoryCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
  @@index([productId])
}

// ── Phase 8: Sales & Marketing ──

enum SalesAreaType {
  DOOR_KNOCK
  FLYER_DROP
  REFERRAL
  ONLINE_AD
  SOCIAL_MEDIA
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model SalesArea {
  id        String        @id @default(cuid())
  name      String
  type      SalesAreaType
  latitude  Float
  longitude Float
  address   String?
  notes     String?
  date      DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type])
  @@index([date])
}

model LandingPage {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String      @db.Text
  ctaText     String      @default("Get a Free Quote")
  ctaLink     String      @default("/")
  isPublished Boolean     @default(false)
  campaignId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  campaign    MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  visits      PageVisit[]

  @@index([slug])
  @@index([campaignId])
}

model PageVisit {
  id            String      @id @default(cuid())
  landingPageId String
  ipHash        String?
  referrer      String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId])
  @@index([createdAt])
}

// ── Chat ──

enum ChatSenderRole {
  EMPLOYEE
  ADMIN
}

model ChatConversation {
  id                     String        @id @default(cuid())
  employeeId             String        @unique
  lastMessageAt          DateTime?
  lastEmployeeMessageAt  DateTime?
  lastAdminMessageAt     DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  employee               User          @relation("EmployeeChatConversation", fields: [employeeId], references: [id], onDelete: Cascade)
  messages               ChatMessage[]

  @@index([lastMessageAt])
}

model ChatMessage {
  id               String           @id @default(cuid())
  conversationId   String
  senderId         String
  senderRole       ChatSenderRole
  body             String           @db.Text
  readByAdminAt    DateTime?
  readByEmployeeAt DateTime?
  createdAt        DateTime         @default(now())
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MarketingCampaign {
  id           String         @id @default(cuid())
  name         String
  description  String?
  status       CampaignStatus @default(DRAFT)
  budget       Float          @default(0)
  spent        Float          @default(0)
  startDate    DateTime?
  endDate      DateTime?
  channel      String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  landingPages LandingPage[]

  @@index([status])
  @@index([startDate])
}
