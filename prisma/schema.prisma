  @@index([startDate])
  @@index([status])
}

model Payout {
  id             String    @id @default(cuid())
  payPeriodId    String
  employeeId     String
  baseAmount     Float     @default(0)
  adjustments    Float     @default(0)
  deductions     Float     @default(0)
  reimbursements Float     @default(0)
  finalAmount    Float     @default(0)
  jobCount       Int       @default(0)
  totalHours     Float     @default(0)
